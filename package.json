{
  "name": "midi-info",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/app.ts --bundle --outfile=app.js --define:__COMMIT_HASH__=\\\"$(git rev-parse --short HEAD)\\\"",
    "watch": "esbuild src/app.ts --bundle --outfile=app.js --watch --define:__COMMIT_HASH__=\\\"$(git rev-parse --short HEAD)\\\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
